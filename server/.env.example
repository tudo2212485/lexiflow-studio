# LexiFlow Studio - Server Configuration Example
PORT=5000
NODE_ENV=production

# Database Connection (Neon, Supabase, or Local PostgreSQL)
# Option A: Neon Cloud PostgreSQL (Recommended for Vercel):
# DATABASE_URL=postgresql://user:password@ep-round-bird-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option B: Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# Option C: Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexiflow_db

# JWT Secret for Auth Tokens
JWT_SECRET=lexiflow_super_secret_jwt_key_2026_modern_fullstack_studio

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gmail SMTP Configuration for Real OTP Delivery (Optional, used for sending verification codes)
SMTP_EMAIL=your-gmail@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password

