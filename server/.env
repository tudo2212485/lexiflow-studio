# LexiFlow Studio - Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Default PostgreSQL 17 on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexiflow_db

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=lexiflow_db

# JWT Secret for Auth Tokens
JWT_SECRET=lexiflow_super_secret_jwt_key_2026_modern_fullstack_studio

# Google OAuth Client ID (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Gmail SMTP Configuration for Real OTP Delivery
# Use your Gmail address and 16-character App Password (from Google Account > Security > 2-Step Verification > App passwords)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
